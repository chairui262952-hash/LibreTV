{
  "version": 2,
  "builds": [
    {
      "src": "server.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/proxy/(.*)",
      "dest": "/api/proxy/$1"
    },
    {
      "src": "/s=(.*)",
      "dest": "/server.mjs"
    },
    {
      "src": "/player.html",
      "dest": "/server.mjs"
    },
    {
      "src": "/(.*)",
      "dest": "/server.mjs"
    }
  ]
}
