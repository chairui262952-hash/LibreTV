{
  "version": 2,
  "builds": [
    {
      "src": "css/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "js/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "libs/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "image/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "about.html",
      "use": "@vercel/static"
    },
    {
      "src": "watch.html",
      "use": "@vercel/static"
    },
    {
      "src": "VERSION.txt",
      "use": "@vercel/static"
    },
    {
      "src": "api/proxy/[...path].mjs",
      "use": "@vercel/node"
    },
    {
      "src": "server.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/proxy/(.*)", "dest": "/api/proxy/$1" },
    { "src": "/s=(.*)", "dest": "/server.mjs" },
    { "src": "/player.html", "dest": "/server.mjs" },
    { "src": "/(.*)", "dest": "/server.mjs" }
  ]
}
